{
  "expo": {
    "name": "RIO",
    "slug": "rio-mobile",
    "owner": "raj_sisoudia",
    "scheme": "rio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#eeebe3",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rio.hostel"
    },
    "android": {
      "package": "com.rio.hostel",
      "adaptiveIcon": {
        "backgroundColor": "#1f4033",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#eeebe3"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RIO to scan handover QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RIO to attach photos of items you list.",
          "cameraPermission": "Allow RIO to take photos of items you list."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "85793200-d7a9-4945-b075-316a00cfb813"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/85793200-d7a9-4945-b075-316a00cfb813"
    }
  }
}
